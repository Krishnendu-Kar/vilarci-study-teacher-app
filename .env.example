# Copy to .env.local and fill in. Never commit the filled file.
# Only EXPO_PUBLIC_* vars are inlined into the client bundle — put nothing
# secret here beyond the anon/publishable key, which is safe by design.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
