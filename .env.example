# Copy to .env and fill in. .env is git-ignored.
# Only EXPO_PUBLIC_* vars are inlined into the client bundle — put nothing
# secret here beyond the publishable key, which is safe by design.
# Same Supabase project as the student/parent app ("Vilarci-study").
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
